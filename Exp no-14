#include <stdio.h>
#include <ctype.h>
int main() {
    char s[50], t = 'A';
    int i;
    printf("Enter expression: ");
    scanf("%s", s);
    for(i = 0; s[i]; i++) {
        if(s[i]=='*' || s[i]=='/' || s[i]=='+' || s[i]=='-') {
            printf("%c = %c %c %c\n",
                   t++, s[i-1], s[i], s[i+1]);
        }
    }
    return 0;
}
Input:
a+b*c
Output:
A = b * c
B = a + b
