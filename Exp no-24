//LEX – Remove Comments and Count Them
#include <stdio.h>
int comments = 0;
FILE *out;
%}
%%
"//".*                    { comments++; }
"/*"([^*]|\*+[^*/])*\*+"/" { comments++; }
\n                        { fputc('\n', out); }
.                         { fputc(yytext[0], out); }
%%
int main()
{
    out = fopen("output.c", "w");
    if (out == NULL)
    {
        printf("Cannot create output file\n");
        return 1;
    }
    yylex();
    fclose(out);
    printf("Number of comments = %d\n", comments);
    return 0;
}
int yywrap()
{
    return 1;
}

