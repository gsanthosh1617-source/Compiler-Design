//LEX Program to Separate Keywords and Identifiers 
%{
#include <stdio.h>
%}
%%
"if"|"else"|"while"|"int"|"float"|"return" { printf("Keyword    : %s\n", yytext); }
[a-zA-Z_][a-zA-Z0-9_]*                    { printf("Identifier : %s\n", yytext); }
.|\n                                      ;
%%
int yywrap() { return 1; }
int main() {
    yylex();
    return 0;
}
