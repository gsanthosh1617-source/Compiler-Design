//Lexical Analyzer using LEX to Separate Tokens 
%{
#include <stdio.h>
%}
%%
"#include"[^\n]*       { printf("[Header File] : %s\n", yytext); }
"void"|"main"|"int"    { printf("[Keyword]     : %s\n", yytext); }
[a-zA-Z_][a-zA-Z0-9_]* { printf("[Identifier]  : %s\n", yytext); }
[0-9]+                 { printf("[Constant]    : %s\n", yytext); }
"="                    { printf("[Operator]    : %s\n", yytext); }
.|\n                   ;
%%
int yywrap() { return 1; }
int main() {
    yylex();
    return 0;
}

Input:
#include<stdio.h>
void main()
{
int a,b,c = 30;
printf("hello");
}

Output:
[Header File] : #include<stdio.h>
[Keyword]     : void
[Keyword]     : main
[Keyword]     : int
[Identifier]  : a
[Identifier]  : b
[Identifier]  : c
[Operator]    : =
[Constant]    : 30
[Identifier]  : printf
