#include <stdio.h>
int main() {
    FILE *fp;
    char ch;
    int c = 0, w = 0, l = 1, inword = 0;
    fp = fopen("input.txt", "r");
    if (fp == NULL) {
        printf("File not found");
        return 0;
    }
    while ((ch = fgetc(fp)) != EOF) {
        c++;
        if (ch == '\n')
            l++;
        if (ch == ' ' || ch == '\n' || ch == '\t')
            inword = 0;
        else if (!inword) {
            w++;
            inword = 1;
        }
    }
    fclose(fp);
    printf("Characters = %d\n", c);
    printf("Words = %d\n", w);
    printf("Lines = %d\n", l);
    return 0;
}
